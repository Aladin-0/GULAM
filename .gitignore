# =============================================================
# Gulam — Polymarket Bot .gitignore
# =============================================================

# !! SECRETS — NEVER COMMIT !!
.env
.env.*
*.pem
*.key

# !! BOT STATE — runtime data, not source !!
bot_state.db
bot_state.db-shm
bot_state.db-wal

# Rust / Cargo
/target/
**/*.rs.bk
Cargo.lock

# Python (legacy)
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
*.log
