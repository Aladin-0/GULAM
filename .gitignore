# =============================================================
# Gulam — Polymarket Bot .gitignore
# =============================================================

# !! SECRETS — NEVER COMMIT !!
.env
.env.*
*.pem
*.key

# !! BOT STATE — runtime data, not source !!
bot_state.db
bot_state.db-shm
bot_state.db-wal

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/
